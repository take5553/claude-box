#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# Launch an isolated, egress-restricted Claude Code container, mounting
# "only the project directory you are currently in".
# Inside the container, claude runs as the node (non-root) user.
#
# Usage:
#   cd ~/dev/project-A
#   claude-box                                  # enter a shell inside the sandbox
#   claude-box claude --dangerously-skip-permissions   # to launch directly
# ---------------------------------------------------------------------------
set -euo pipefail

# The engine (a docker-compatible CLI) and the image can be overridden via
# environment variables. Verified with docker; behavior on a podman host is
# unverified (Docker-specific options such as --security-opt systempaths need
# review. See README).
ENGINE="${CLAUDE_BOX_ENGINE:-docker}"
IMAGE="${CLAUDE_BOX_IMAGE:-claude-box:latest}"
CONFIG_VOLUME="claude-box-config"        # where credentials live (separate from the host's ~/.claude)
CONTAINERS_VOLUME="claude-box-containers" # rootless Podman's image store.
                                          # Not just for caching but a **functional
                                          # requirement**: without it, graphRoot
                                          # lands on Docker's overlayfs, producing
                                          # overlay on overlay, and exec in the
                                          # nested container fails with
                                          # Invalid argument (design 05)

# Reject launching from $HOME or / to avoid accidentally mounting too broadly
if [ "$PWD" = "$HOME" ] || [ "$PWD" = "/" ]; then
  echo "Refusing to launch from $PWD. cd into the target project first." >&2
  exit 1
fi

"$ENGINE" volume inspect "$CONFIG_VOLUME" >/dev/null 2>&1 || "$ENGINE" volume create "$CONFIG_VOLUME" >/dev/null
# CONTAINERS_VOLUME (for nesting) is only created when CLAUDE_BOX_NESTED_CONTAINERS=1 (below).

# Share git identity (name / signing) read-only (only when the file exists).
# Can be disabled with CLAUDE_BOX_NO_GITCONFIG=1. ~/.gitconfig may contain settings
# that cannot be resolved inside the container -- includeIf / signing-key paths /
# credential.helper=osxkeychain -- and can break git (see README for a workaround).
GITCONFIG_MOUNT=()
if [ -z "${CLAUDE_BOX_NO_GITCONFIG:-}" ] && [ -f "$HOME/.gitconfig" ]; then
  GITCONFIG_MOUNT=(-v "$HOME/.gitconfig:/home/node/.gitconfig:ro")
fi

# ---------------------------------------------------------------------------
# Import the host's own Claude Code config (design 08 / 09 / 10 / 11)
#
# A box should behave like the claude you already configured, so the host's
# ~/.claude is brought in **by default** -- settings, skills, agents, commands and
# the global CLAUDE.md. Only those; never the whole directory (credentials, history
# and every project's state stay on the host = design 01). The host's config dir
# follows CLAUDE_CONFIG_DIR, the same way claude does. Only paths that already exist
# are mounted; nothing is created on the host.
#
# Every item has a mode:
#   rw  -- share the host's file/directory. What the box writes lands on the host.
#   ro  -- **the default**. The config comes in, but nothing the box does reaches the
#          host: settings are merged into the box's own copy and CLAUDE.md replaces it
#          (both by entrypoint), directories are mounted read-only.
#   off -- do not bring it in at all.
# CLAUDE_BOX_HOST_CONFIG sets the mode for every item at once, and
# CLAUDE_BOX_{SETTINGS,SKILLS,AGENTS,COMMANDS,PLUGINS,GLOBAL_MD_MODE} override it per
# item (design 11). Read-only is the default because the box runs YOLO and the host's
# Claude reads these same files afterwards; a box that wants to keep a change asks for
# `rw` explicitly (it is told to: entrypoint hands claude a note about the modes below).
# ---------------------------------------------------------------------------
HOST_CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

# resolve_mode <item variable's value> <built-in default> <variable name> -> MODE
# Precedence: the item's own variable, then CLAUDE_BOX_HOST_CONFIG, then the default.
# A typo is fatal rather than silently ignored -- these decide what the box may write.
# Each resolved mode is appended to MODES_SUMMARY, which is passed into the container
# so the in-box claude can say *which* variable to change (design 11).
MODE=""
MODES_SUMMARY=""
resolve_mode() {
  MODE="${1:-${CLAUDE_BOX_HOST_CONFIG:-$2}}"
  case "$MODE" in
    rw|ro|off) ;;
    *) echo "claude-box: $3 must be rw, ro or off (got '$MODE')" >&2; exit 1 ;;
  esac
  MODES_SUMMARY="${MODES_SUMMARY}${MODES_SUMMARY:+ }$3=$MODE"
}

# mount_config_dir <name> <mode> [source dir] -- one of the ~/.claude directories.
mount_config_dir() {
  local name="$1" mode="$2" src="${3:-$HOST_CLAUDE_DIR/$1}"
  [ "$mode" != "off" ] && [ -d "$src" ] || return 0
  if [ "$mode" = "ro" ]; then
    CONFIG_MOUNTS+=(-v "$src:/home/node/.claude/$name:ro")
  else
    CONFIG_MOUNTS+=(-v "$src:/home/node/.claude/$name")
  fi
}

# settings.json / settings.local.json.
#   ro (default): mounted at a dedicated path under /etc/claude-box and *merged* into
#       the box's own copy by entrypoint (host keys win, keys the box set itself
#       survive), so the box keeps a settings.json it can write and the host's file is
#       never touched (design 08). Note the box's writes *succeed* here -- they simply
#       do not travel -- so the note entrypoint hands claude is what makes that visible.
#   rw: the host's files *are* the box's files, so /config, permission changes and
#       the like write straight through. claude writes settings atomically (temp file
#       + rename); renaming onto a bind-mounted file fails with EBUSY, and claude
#       falls back to an in-place write -- which is what makes this work (design 10).
resolve_mode "${CLAUDE_BOX_SETTINGS:-}" ro CLAUDE_BOX_SETTINGS
SETTINGS_MOUNT=()
case "$MODE" in
  rw)
    [ -f "$HOST_CLAUDE_DIR/settings.json" ] \
      && SETTINGS_MOUNT+=(-v "$HOST_CLAUDE_DIR/settings.json:/home/node/.claude/settings.json")
    [ -f "$HOST_CLAUDE_DIR/settings.local.json" ] \
      && SETTINGS_MOUNT+=(-v "$HOST_CLAUDE_DIR/settings.local.json:/home/node/.claude/settings.local.json")
    ;;
  ro)
    [ -f "$HOST_CLAUDE_DIR/settings.json" ] \
      && SETTINGS_MOUNT+=(-v "$HOST_CLAUDE_DIR/settings.json:/etc/claude-box/host-settings.json:ro")
    [ -f "$HOST_CLAUDE_DIR/settings.local.json" ] \
      && SETTINGS_MOUNT+=(-v "$HOST_CLAUDE_DIR/settings.local.json:/etc/claude-box/host-settings.local.json:ro")
    ;;
esac

# skills / agents / commands -- read-only by default: they are all there, but writing
# one fails with EROFS, which is the signal that makes the box ask for `rw` instead of
# silently keeping a skill the host will never see (design 11).
#
# plugins is the exception, read-write: a plugin the host has enabled must work in the
# box (a security plugin that quietly does not come along is the failure we care about
# most), and claude *writes* to this directory as a matter of course -- repairing the
# absolute installLocation paths in known_marketplaces.json, migrating
# installed_plugins.json -- so read-only would mean errors on every launch rather than
# a signal at the moment of a real change. CLAUDE_BOX_PLUGINS=ro/off if you disagree.
# CLAUDE_SKILLS_DIR points skills at another directory -- an explicit source, so the
# family switch does not silence it; if it is set but missing, stop with an explicit
# error rather than creating it (guards against typos).
#   e.g.: CLAUDE_SKILLS_DIR=~/dev/my-skills claude-box
CONFIG_MOUNTS=()
if [ -n "${CLAUDE_SKILLS_DIR:-}" ]; then
  if [ ! -d "$CLAUDE_SKILLS_DIR" ]; then
    echo "claude-box: CLAUDE_SKILLS_DIR=$CLAUDE_SKILLS_DIR does not exist as a directory" >&2
    exit 1
  fi
  resolve_mode "${CLAUDE_BOX_SKILLS:-ro}" ro CLAUDE_BOX_SKILLS
  mount_config_dir skills "$MODE" "$CLAUDE_SKILLS_DIR"
else
  resolve_mode "${CLAUDE_BOX_SKILLS:-}" ro CLAUDE_BOX_SKILLS
  mount_config_dir skills "$MODE"
fi
resolve_mode "${CLAUDE_BOX_AGENTS:-}" ro CLAUDE_BOX_AGENTS
mount_config_dir agents "$MODE"
resolve_mode "${CLAUDE_BOX_COMMANDS:-}" ro CLAUDE_BOX_COMMANDS
mount_config_dir commands "$MODE"
resolve_mode "${CLAUDE_BOX_PLUGINS:-}" rw CLAUDE_BOX_PLUGINS
mount_config_dir plugins "$MODE"

# Global CLAUDE.md. Default `ro`: mounted read-only at the path below, and entrypoint
# *replaces* the box's copy with it at every launch -- so the box's house rules are
# exactly the host's, while a `#`-shortcut memory written in the box stays in the box.
# With `rw` the host's file is mounted straight over the box's copy and those memories
# land on the host (design 09/10/11). Note that the box's own guidance does *not* live
# in this file: it is appended to claude's system prompt instead, so it works the same
# in every mode and never gets written into the host's CLAUDE.md.
# CLAUDE_BOX_GLOBAL_MD overrides the source file -- an explicit source, so the family
# switch does not silence it; a path that does not exist is a warning, not a failure.
GLOBAL_MD_MOUNT=()
GLOBAL_MD_FILE=""
if [ -n "${CLAUDE_BOX_GLOBAL_MD:-}" ]; then
  resolve_mode "${CLAUDE_BOX_GLOBAL_MD_MODE:-ro}" ro CLAUDE_BOX_GLOBAL_MD_MODE
  if [ -f "$CLAUDE_BOX_GLOBAL_MD" ]; then
    GLOBAL_MD_FILE="$CLAUDE_BOX_GLOBAL_MD"
  else
    echo "claude-box: CLAUDE_BOX_GLOBAL_MD=$CLAUDE_BOX_GLOBAL_MD not found (skipping injection)" >&2
  fi
else
  resolve_mode "${CLAUDE_BOX_GLOBAL_MD_MODE:-}" ro CLAUDE_BOX_GLOBAL_MD_MODE
  if [ -f "$HOST_CLAUDE_DIR/CLAUDE.md" ]; then
    GLOBAL_MD_FILE="$HOST_CLAUDE_DIR/CLAUDE.md"
  fi
fi
if [ -n "$GLOBAL_MD_FILE" ]; then
  case "$MODE" in
    rw) GLOBAL_MD_MOUNT=(-v "$GLOBAL_MD_FILE:/home/node/.claude/CLAUDE.md") ;;
    ro) GLOBAL_MD_MOUNT=(-v "$GLOBAL_MD_FILE:/etc/claude-box/global-CLAUDE.md:ro") ;;
  esac
fi

# This project's session logs (design 13). Off by default: transcripts and auto-memory
# live in the box's volume, out of the host's sight (design 03). CLAUDE_BOX_SESSIONS=rw
# bind-mounts the host's own ~/.claude/projects/<key>/ -- for *this* project only --
# over the volume's copy, so host tools that read Claude Code sessions (orca, the
# host's `claude --resume`) see what the box writes, and the box sees the host's
# sessions for the same project.
#
# This is a box -> host write path into files the host's Claude *loads*: the auto-memory
# in <key>/memory/ goes into its context at startup, and a transcript can be resumed
# there. It is therefore not part of CLAUDE_BOX_HOST_CONFIG (which would make
# CLAUDE_BOX_HOST_CONFIG=rw open it as a side effect); it has its own switch. There is
# no `ro`: claude has to write its transcript, so a read-only mount would just break it.
#
# The key is the project path with every non-alphanumeric character replaced by `-`
# (the project is mounted at the same path, so it matches the host's key). claude
# shortens keys over 200 characters with a hash we do not reproduce -- refuse those
# rather than mount a directory claude will not use.
SESSIONS_MODE="${CLAUDE_BOX_SESSIONS:-off}"
SESSIONS_MOUNT=()
case "$SESSIONS_MODE" in
  rw|off) ;;
  *) echo "claude-box: CLAUDE_BOX_SESSIONS must be rw or off (got '$SESSIONS_MODE')" >&2; exit 1 ;;
esac
if [ "$SESSIONS_MODE" = "rw" ]; then
  PROJECT_KEY="$(printf '%s' "$PWD" | LC_ALL=C sed 's/[^a-zA-Z0-9]/-/g')"
  if [ "${#PROJECT_KEY}" -gt 200 ]; then
    echo "claude-box: CLAUDE_BOX_SESSIONS=rw: the project path is too long for a plain session key (claude hashes it); not sharing sessions" >&2
    SESSIONS_MODE=off
  else
    SESSIONS_SRC="$HOST_CLAUDE_DIR/projects/$PROJECT_KEY"
    mkdir -p "$SESSIONS_SRC"
    SESSIONS_MOUNT=(-v "$SESSIONS_SRC:/home/node/.claude/projects/$PROJECT_KEY")
  fi
fi
MODES_SUMMARY="${MODES_SUMMARY} CLAUDE_BOX_SESSIONS=$SESSIONS_MODE"

# Hand the resolved modes to the container. entrypoint turns them into a note appended
# to claude's system prompt, so the in-box claude knows a change it makes to ~/.claude
# will not reach the host, and can name the variable that would let it (design 11).
MODES_ENV=(-e "CLAUDE_BOX_MODES=$MODES_SUMMARY")

# rw on a Linux host whose user is not uid 1000. A bind mount keeps the host's
# ownership as is, and the box runs as node (uid 1000), so the box can read the
# shared files but writing them fails with "Permission denied". Docker Desktop on
# macOS translates ownership, and a typical Linux desktop's first user is uid 1000,
# so neither is affected. Warn rather than silently switch to ro: the mode is the
# user's choice, and design 10 records the limitation.
if [ "$(uname -s)" = "Linux" ] && [ "$(id -u)" != "1000" ]; then
  rw_items=""
  for kv in $MODES_SUMMARY; do
    [ "${kv#*=}" = "rw" ] && rw_items="${rw_items}${rw_items:+ }${kv%=*}"
  done
  if [ -n "$rw_items" ]; then
    echo "claude-box: WARN: your uid is $(id -u), the box runs as uid 1000; writes from the box to rw imports will fail with Permission denied ($rw_items). Set them to ro if you do not need writes (design 10)." >&2
  fi
fi

# Only when you want to allow GitHub operations (push / PR / issue / merge),
# pass a scope-limited, short-lived token *at runtime only* (never stored).
#   GH_TOKEN="$(security find-generic-password -s claude-box-gh -w)" claude-box
GH_ENV=()
[ -n "${GH_TOKEN:-}" ] && GH_ENV=(-e "GH_TOKEN=${GH_TOKEN}")

# Request outbox for the env-request feature (on by default). The in-box Claude drops
# change-request files here for a maintainer to review on the host (no GitHub, no
# network). Defaults to ~/.claude-box/requests; override the host location with
# CLAUDE_BOX_REQUEST_DIR, or turn the feature off entirely with
# CLAUDE_BOX_NO_REQUEST_DIR=1. Keep this a dedicated drop folder — not your source
# tree — and treat whatever lands in it as untrusted (docs/env-request-operations.md).
REQUEST_DIR_MOUNT=()
REQUEST_DIR_ENV=()
if [ -z "${CLAUDE_BOX_NO_REQUEST_DIR:-}" ]; then
  REQUEST_DIR="${CLAUDE_BOX_REQUEST_DIR:-$HOME/.claude-box/requests}"
  mkdir -p "$REQUEST_DIR"
  REQUEST_DIR_MOUNT=(-v "$REQUEST_DIR:/home/node/.claude-box/requests")
  REQUEST_DIR_ENV=(-e "CLAUDE_BOX_REQUEST_DIR=/home/node/.claude-box/requests")

  # The return channel: the maintainer's replies to those requests (design 12).
  # Mounted READ-ONLY and kept apart from the outbox on purpose: every box shares the
  # outbox read-write, so a reply placed there could be forged by any (possibly
  # injected) box and then trusted by another project's Claude. Read-only makes the
  # maintainer, on the host, the only writer. Defaults to ~/.claude-box/replies;
  # relocate with CLAUDE_BOX_REPLY_DIR. Off together with the outbox.
  REPLY_DIR="${CLAUDE_BOX_REPLY_DIR:-$HOME/.claude-box/replies}"
  mkdir -p "$REPLY_DIR"
  # If one folder sat inside the other, the box could write replies through the
  # read-write outbox mount and the :ro below would protect nothing. Refuse.
  req_real="$(cd "$REQUEST_DIR" && pwd -P)"
  rep_real="$(cd "$REPLY_DIR" && pwd -P)"
  case "$rep_real/" in "$req_real"/*) overlap=1 ;; *) overlap="" ;; esac
  case "$req_real/" in "$rep_real"/*) overlap=1 ;; esac
  if [ -n "$overlap" ]; then
    echo "claude-box: CLAUDE_BOX_REPLY_DIR ($rep_real) and CLAUDE_BOX_REQUEST_DIR ($req_real) must not contain each other" >&2
    exit 2
  fi
  REQUEST_DIR_MOUNT+=(-v "$REPLY_DIR:/home/node/.claude-box/replies:ro")
  REQUEST_DIR_ENV+=(-e "CLAUDE_BOX_REPLY_DIR=/home/node/.claude-box/replies")
fi

# Normalize terminal colors (avoid color mismatches on terminals lacking terminfo)
TERM_ENV=(-e TERM=xterm-256color -e COLORTERM=truecolor -e LANG=C.UTF-8)

# Notification bridge (opt-in; the cmux-specific implementation is split out into
# contrib/cmux/). When CLAUDE_BOX_NOTIFY_BRIDGE points to an executable, the host
# launches it and reads the port number printed on the first line of stdout. That
# port is passed to the container as CLAUDE_BOX_BRIDGE_PORT together with a
# host.docker.internal mapping, so the in-container Claude's hook can forward
# notifications there. If the bridge exits without printing anything (= nothing to
# attach to), launch without a bridge. contrib/cmux/notify-bridge is one example
# of an implementation that satisfies this contract.
BRIDGE_ENV=()
BRIDGE_PID=""
if [ -n "${CLAUDE_BOX_NOTIFY_BRIDGE:-}" ] && [ -x "$CLAUDE_BOX_NOTIFY_BRIDGE" ]; then
  BRIDGE_PORT_FILE="$(mktemp)"
  "$CLAUDE_BOX_NOTIFY_BRIDGE" > "$BRIDGE_PORT_FILE" &
  BRIDGE_PID=$!
  BRIDGE_PORT=""
  for _ in $(seq 1 40); do
    BRIDGE_PORT="$(head -n1 "$BRIDGE_PORT_FILE" 2>/dev/null || true)"
    [ -n "$BRIDGE_PORT" ] && break
    kill -0 "$BRIDGE_PID" 2>/dev/null || break  # don't keep waiting if the bridge exited immediately (declined)
    sleep 0.05
  done
  rm -f "$BRIDGE_PORT_FILE"
  if [ -n "$BRIDGE_PORT" ]; then
    # host.docker.internal resolves automatically on Docker Desktop, but declare it
    # explicitly in /etc/hosts so it also works on a Linux engine (the firewall side
    # resolves it via getent)
    BRIDGE_ENV=(-e "CLAUDE_BOX_BRIDGE_PORT=${BRIDGE_PORT}" --add-host=host.docker.internal:host-gateway)
  else
    kill "$BRIDGE_PID" 2>/dev/null || true
    BRIDGE_PID=""
    echo "claude-box: WARN notification bridge returned no port (continuing without notifications)" >&2
  fi
fi
cleanup() { [ -n "$BRIDGE_PID" ] && kill "$BRIDGE_PID" 2>/dev/null || true; }
trap cleanup EXIT

# Nested container execution (rootless Podman inside the container) is off by
# default. Only when used is it loosened via CLAUDE_BOX_NESTED_CONTAINERS=1 (don't
# loosen by default for people who don't use it). The following are added, all for
# the in-container Podman. Caps are not increased; this is distinct from --privileged
# DinD (the nested side's egress also goes through the outer firewall). The rationale
# and default are also stated in the security section of the README.
#   seccomp=unconfined     : the default profile blocks mount etc. inside a user namespace
#   systempaths=unconfined : removes the /proc mask (without it the nested side cannot
#                            remount /proc and fails to start). Non-root operation, so
#                            /proc/sys still cannot be written
#   /dev/fuse              : for the fuse-overlayfs fallback on paths where overlay is unavailable
#   /dev/net/tun           : for creating the tap of the nested-side network (pasta/slirp4netns)
#   dedicated volume       : moves graphRoot off Docker's overlay (overlay on overlay).
#                            without it, nested-side exec fails with Invalid argument (design 05)
#   (on a Linux host with AppArmor enabled, --security-opt apparmor=unconfined is also required)
NESTED_OPTS=()
if [ "${CLAUDE_BOX_NESTED_CONTAINERS:-0}" = "1" ]; then
  "$ENGINE" volume inspect "$CONTAINERS_VOLUME" >/dev/null 2>&1 || "$ENGINE" volume create "$CONTAINERS_VOLUME" >/dev/null
  NESTED_OPTS=(
    --security-opt seccomp=unconfined
    --security-opt systempaths=unconfined
    --device /dev/fuse
    --device /dev/net/tun
    -v "$CONTAINERS_VOLUME:/home/node/.local/share/containers"
  )
fi

# A bind mount at ~/.claude/projects/<key> makes the engine create the mount point and
# any missing parent inside the volume -- as root. A root-owned projects/ would stop
# every *other* project's box from saving its transcripts, and a root-owned <key>/
# would do the same to this project once it is launched with sessions off again. So
# create both first, as node (the image's user), in a throwaway container with no
# network and no capabilities (design 13).
if [ "${#SESSIONS_MOUNT[@]}" -gt 0 ]; then
  "$ENGINE" run --rm --cap-drop=ALL --network none --entrypoint mkdir \
    -v "$CONFIG_VOLUME:/home/node/.claude" "$IMAGE" -p "/home/node/.claude/projects/$PROJECT_KEY"
fi

# Mount the project at the same absolute path as on the host (and match -w). Claude
# Code saves history keyed by the current path, so a fixed /workspace would mix the
# history of every project under the same key. See README for the list of host
# resources brought into the container.
#
# --cap-drop=ALL drops everything, then adds back only the needed capabilities:
#   NET_ADMIN/NET_RAW = firewall (iptables); SETUID/SETGID = for the firewall's limited
#     sudo and for launching the egress proxy under a dedicated uid (design 02)
#   AUDIT_WRITE = sending sudo's audit messages (without it, warning noise appears)
# Make it work even for invocations without a TTY (via script / pipe)
TTY_FLAGS=(-it)
[ -t 0 ] || TTY_FLAGS=(-i)

# Run in the foreground rather than exec (so the EXIT trap can clean up the bridge on exit)
"$ENGINE" run --rm "${TTY_FLAGS[@]}" \
  --cap-drop=ALL \
  --cap-add=NET_ADMIN \
  --cap-add=NET_RAW \
  --cap-add=SETUID \
  --cap-add=SETGID \
  --cap-add=AUDIT_WRITE \
  "${NESTED_OPTS[@]}" \
  -v "$PWD:$PWD" \
  -v "$CONFIG_VOLUME:/home/node/.claude" \
  "${CONFIG_MOUNTS[@]}" \
  "${GLOBAL_MD_MOUNT[@]}" \
  "${SETTINGS_MOUNT[@]}" \
  "${SESSIONS_MOUNT[@]}" \
  "${MODES_ENV[@]}" \
  "${GITCONFIG_MOUNT[@]}" \
  "${GH_ENV[@]}" \
  "${REQUEST_DIR_MOUNT[@]}" \
  "${REQUEST_DIR_ENV[@]}" \
  "${TERM_ENV[@]}" \
  "${BRIDGE_ENV[@]}" \
  -w "$PWD" \
  "$IMAGE" \
  "$@"

